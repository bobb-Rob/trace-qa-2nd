# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Docker files
Dockerfile text eol=lf
Dockerfile.* text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
docker-entrypoint.sh text eol=lf

# Config files
*.config.js text eol=lf
*.config.ts text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
tsconfig*.json text eol=lf

# Binary files (no conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.webm binary
*.mp4 binary
